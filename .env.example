# 复制为 .env 后按需修改，docker compose 会自动读取
#
# Web UI 登录密码：留空则首次启动自动生成，写入 /data/webui-password 并打印在
# `docker logs` 里（之后一直复用）；想自己指定就填在这里（不要把这个文件提交到公开仓库）。
CLASH_PARTY_WEBUI_PASSWORD=
# 镜像标签：latest / smart_core / sha-<短哈希> / 具体版本号
CLASH_PARTY_TAG=latest
# Web UI 对外端口
CLASH_PARTY_PORT=8080
# 时区
TZ=Asia/Shanghai
